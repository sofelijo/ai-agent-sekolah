[Unit]
Description=ASKA Landing Page
After=network.target

[Service]
WorkingDirectory=/opt/ai-agent-sekolah
EnvironmentFile=/opt/ai-agent-sekolah/.env
ExecStart=/opt/ai-agent-sekolah/venv/bin/gunicorn -w 2 -k gthread -b 127.0.0.1:5003 landingpage.app:app
User=www-data
Group=www-data
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
